# Postgres connection string (Supabase, Neon, etc.)
# Example: postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Supabase Auth / browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Separate database URL for E2E tests (set this to a test database)
# Required when running `pnpm exec playwright test`
DATABASE_URL_TEST=
